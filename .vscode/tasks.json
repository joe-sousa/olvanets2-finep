{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build ns-3",
      "type": "shell",
      "command": "./waf",
      "args": ["build"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "run ns-3",
      "type": "shell",
      "command": "./build/scratch/olvanets/olvanets",
      "args": [
        "--run=1",
        "--tracePath=/home/alisson/ns-3.29/mobilityTraces/",
        "--scenario=urban",
        "--density=low",
        "--cellcoverage=100",
        "--knownroutes=50",
        "--workload=1",
        "--algorithm=gtt",
        "--clientType=moto"
      ],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ]
}
  